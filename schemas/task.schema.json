{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Collection task",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "task_id",
    "sample_id",
    "repository_id",
    "task_type",
    "due_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "task"},
    "protocol_version": {"const": "v1"},
    "task_id": {"type": "string"},
    "sample_id": {"type": "string"},
    "repository_id": {"type": "integer"},
    "task_type": {
      "enum": ["snapshot", "stars-30d", "stars-90d", "stars-180d"]
    },
    "horizon_days": {
      "type": ["integer", "null"],
      "enum": [null, 30, 90, 180]
    },
    "due_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
